{
  "name": "slash-tokens",
  "version": "1.7.0",
  "description": "Know what an LLM call will cost before you make it, and prove what you saved after. Quote, decide, receipt. 4.8 KB WASM, zero dependencies.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "slash-tokens": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./auto": {
      "import": "./dist/auto.js",
      "types": "./dist/auto.d.ts"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "npx tsc && bun build src/cli.ts --outfile=dist/cli.js --target=node",
    "test": "bun test",
    "check:engines": "node scripts/check-engines.mjs",
    "check:freshness": "bun scripts/check-freshness.ts",
    "bench:nemotron": "bun bench/calibrate-nemotron.ts"
  },
  "author": "wolfejam",
  "license": "MIT",
  "keywords": [
    "tokens",
    "wasm",
    "edge",
    "budget",
    "estimation",
    "llm",
    "ai",
    "openai",
    "anthropic",
    "claude",
    "grok",
    "gemini",
    "nemotron",
    "nvidia",
    "nebius",
    "agent",
    "cost"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Wolfe-Jam/slash-tokens"
  },
  "homepage": "https://slashtokens.com",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "js-tiktoken": "^1.0.21",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
